<Window x:Class="BnbcUltimatePro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BNBC ULTIMATE PRO - ETABS 22 (MVP 0.1)" Width="1200" Height="780"
        MinWidth="1000" MinHeight="640" WindowStartupLocation="CenterScreen" Background="#0B1730">
  <Window.Resources>
    <SolidColorBrush x:Key="Card" Color="#13264D"/>
    <SolidColorBrush x:Key="Cyan" Color="#22D3EE"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/></Style>
    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#9FB4D9"/><Setter Property="Margin" Value="0,10,0,3"/>
    </Style>
    <ControlTemplate x:Key="BtnTpl" TargetType="Button">
      <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="NavBtn" TargetType="Button">
      <Setter Property="Template" Value="{StaticResource BtnTpl}"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="16,11"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="ActBtn" TargetType="Button">
      <Setter Property="Template" Value="{StaticResource BtnTpl}"/>
      <Setter Property="Background" Value="#2563EB"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="5"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="Black"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="5"/></Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Background="#081126">
      <StackPanel>
        <TextBlock Text="BNBC" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="18,22,0,0"/>
        <TextBlock Text="ULTIMATE PRO" FontSize="14" FontWeight="SemiBold" Margin="18,0,0,22"/>
        <Button Style="{StaticResource NavBtn}" Content="Dashboard" Tag="PageDashboard" Click="Nav_Click"/>
        <Button Style="{StaticResource NavBtn}" Content="Project Setup" Tag="PageProject" Click="Nav_Click"/>
        <Button Style="{StaticResource NavBtn}" Content="Seismic Parameters" Tag="PageSeismic" Click="Nav_Click"/>
        <Button Style="{StaticResource NavBtn}" Content="Load Patterns" Tag="PageLoads" Click="Nav_Click"/>
        <Button Style="{StaticResource NavBtn}" Content="Load Combinations" Tag="PageCombos" Click="Nav_Click"/>
        <Button Style="{StaticResource NavBtn}" Content="Floor &amp; Wall Loads" Tag="PageFloors" Click="Nav_Click"/>
        <Button Style="{StaticResource NavBtn}" Content="Foundation Reactions" Tag="PageReact" Click="Nav_Click"/>
        <Button Style="{StaticResource NavBtn}" Content="Seismic Static Analysis" Tag="PageSeis" Click="Nav_Click"/>
        <Button Style="{StaticResource NavBtn}" Content="Wind Load" Tag="PageWind" Click="Nav_Click"/>
        <Button Style="{StaticResource NavBtn}" Content="Model Checker" Tag="PageCheck" Click="Nav_Click"/>
        <Button Style="{StaticResource NavBtn}" Content="Compliance Checker" Tag="PageComp" Click="Nav_Click"/>
        <Button Style="{StaticResource NavBtn}" Content="Report" Tag="PageReport" Click="Nav_Click"/>
        <TextBlock Text="BNBC 2020 / ETABS 22" Foreground="#6B7FA8" FontSize="11" Margin="18,30,0,0"/>
      </StackPanel>
    </Border>

    <Grid Grid.Column="1" Margin="18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>

      <!-- Connection bar -->
      <Border Background="{StaticResource Card}" CornerRadius="6" Padding="14,10">
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource ActBtn}" Content="Detect / Connect ETABS" Click="Connect_Click" Margin="0"/>
          <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="#EF4444" Margin="0,0,10,0" DockPanel.Dock="Left"/>
          <TextBlock x:Name="StatusText" Text="ETABS: not connected" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1" Margin="0,14,0,14">
        <!-- Dashboard -->
        <Border x:Name="PageDashboard" Background="{StaticResource Card}" CornerRadius="6" Padding="20">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="Dashboard" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Project completeness" Style="{StaticResource Lbl}" Margin="0,16,0,3"/>
            <TextBlock x:Name="TxtCompleteness" FontFamily="Consolas" TextWrapping="Wrap"/>
            <TextBlock Text="Module status" Style="{StaticResource Lbl}" Margin="0,16,0,3"/>
            <TextBlock FontFamily="Consolas" TextWrapping="Wrap" Text="[MVP] Project Setup (Project Information Panel)&#10;[MVP] Seismic Zone / Importance / Soil parameters (BNBC Tables 6.2.15, 6.2.16, 6.2.17)&#10;[MVP] ETABS 22 detect and connect&#10;[MVP] Load Pattern creation (preview, duplicate check, confirmation)&#10;[MVP] Save/Load project, text report export&#10;[PLANNED] Wind, Dead/Live load calculator, Wall loads, Combinations, Checker, Reactions, PDF/Excel"/>
            <TextBlock Text="Nothing is marked PASS when data is missing. See the Testing Report for what has been tested." Foreground="#9FB4D9" TextWrapping="Wrap" Margin="0,16,0,0"/>
          </StackPanel></ScrollViewer>
        </Border>

        <!-- Project -->
        <Border x:Name="PageProject" Background="{StaticResource Card}" CornerRadius="6" Padding="20" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="460" HorizontalAlignment="Left">
            <TextBlock Text="Project Setup" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Project name" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtName" LostFocus="Field_Changed"/>
            <TextBlock Text="Location (town) - BNBC Table 6.2.15" Style="{StaticResource Lbl}"/><ComboBox x:Name="CmbTown" SelectionChanged="Field_Changed"/>
            <TextBlock Text="Seismic zone coefficient Z (from table)" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtZ" IsReadOnly="True" Background="#DDE6F5"/>
            <TextBlock Text="Soil type (from your geotechnical report - never assumed)" Style="{StaticResource Lbl}"/><ComboBox x:Name="CmbSoil" SelectionChanged="Field_Changed"/>
            <TextBlock Text="Occupancy category - BNBC Table 6.1.1 / 6.2.17" Style="{StaticResource Lbl}"/><ComboBox x:Name="CmbOcc" SelectionChanged="Field_Changed"/>
            <TextBlock Text="Number of stories" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtStories" LostFocus="Field_Changed"/>
            <TextBlock Text="Notes" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtNotes" AcceptsReturn="True" Height="70" LostFocus="Field_Changed"/>
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
              <Button Style="{StaticResource ActBtn}" Content="Save Project" Click="Save_Click"/>
              <Button Style="{StaticResource ActBtn}" Content="Load Project" Click="Load_Click"/>
            </StackPanel>
          </StackPanel></ScrollViewer>
        </Border>

        <!-- Seismic -->
        <Border x:Name="PageSeismic" Background="{StaticResource Card}" CornerRadius="6" Padding="20" Visibility="Collapsed">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Seismic Parameters (preview)" FontSize="22" FontWeight="Bold"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,12,0,12">
              <Button Style="{StaticResource ActBtn}" Content="Generate Preview" Click="SeismicPreview_Click"/>
              <Button Style="{StaticResource ActBtn}" Content="Export Report (.txt)" Click="Export_Click"/>
            </StackPanel>
            <TextBox x:Name="TxtSeismic" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
          </DockPanel>
        </Border>

        <!-- Loads -->
        <Border x:Name="PageLoads" Background="{StaticResource Card}" CornerRadius="6" Padding="20" Visibility="Collapsed">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Load Patterns" FontSize="22" FontWeight="Bold"/>
            <TextBlock DockPanel.Dock="Top" Foreground="#9FB4D9" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Edit the list, press Refresh Preview to compare with the open ETABS model (existing names are skipped), then Create."/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,12,0,12">
              <Button Style="{StaticResource ActBtn}" Content="Refresh Preview" Click="LoadPreview_Click"/>
              <Button Style="{StaticResource ActBtn}" Content="Create in ETABS" Click="CreatePatterns_Click" Background="#0891B2"/>
              <Button Style="{StaticResource ActBtn}" Content="Add row" Click="AddRow_Click" Background="#334A7A"/>
            </StackPanel>
            <DataGrid x:Name="LoadGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridComboBoxColumn Header="Type" SelectedItemBinding="{Binding Type}" Width="140"/>
                <DataGridTextColumn Header="Self-weight mult." Binding="{Binding SelfWeight}" Width="130"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="200"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>

        <!-- Combinations -->
        <Border x:Name="PageCombos" Background="{StaticResource Card}" CornerRadius="6" Padding="20" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="Load Combinations (BNBC 2020 Sec 2.7)" FontSize="22" FontWeight="Bold"/>
            <TextBlock Foreground="#9FB4D9" TextWrapping="Wrap" Margin="0,6,0,8"
                       Text="Type the ETABS load pattern names for each symbol, separated by commas. D, F, H, L, Lr, R, T: all listed names are added together. W and E: each name makes its own set of combinations. Leave blank if the load is not used."/>
            <DataGrid x:Name="MapGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Height="270">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" IsReadOnly="True" Width="60"/>
                <DataGridTextColumn Header="Load" Binding="{Binding Description}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="ETABS load name(s)" Binding="{Binding Patterns}" Width="280"/>
              </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Margin="0,10,0,0">
              <CheckBox x:Name="ChkUls" IsChecked="True" Margin="0,0,18,4"><TextBlock Text="Strength design (Sec 2.7.3)" TextWrapping="Wrap"/></CheckBox>
              <CheckBox x:Name="ChkAsd" Margin="0,0,18,4"><TextBlock Text="Allowable stress (Sec 2.7.2)" TextWrapping="Wrap"/></CheckBox>
              <CheckBox x:Name="ChkPm" IsChecked="True" Margin="0,0,18,4"><TextBlock Text="Both directions (+ and -) for W and E" TextWrapping="Wrap"/></CheckBox>
            </WrapPanel>
            <CheckBox x:Name="ChkL05" Margin="0,2,0,2"><TextBlock TextWrapping="Wrap" Text="Exception 1: L factor 0.5 in strength combinations 3, 4, 5 (only if live load is 5.0 kN/m2 or less and the area is not a garage or public assembly)"/></CheckBox>
            <CheckBox x:Name="Chk13W" Margin="0,2,0,2"><TextBlock TextWrapping="Wrap" Text="Exception 3: 1.3W instead of 1.6W in strength combinations 4 and 6 (reinforced concrete, W not reduced by a directionality factor)"/></CheckBox>
            <TextBlock Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Not generated: flood / tidal-surge combinations (Fa), and Ev inside E. If your E already includes the vertical part, use that load name for E. You decide the exceptions above; nothing is applied automatically."/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
              <Button Style="{StaticResource ActBtn}" Content="Generate Preview" Click="ComboPreview_Click"/>
              <Button Style="{StaticResource ActBtn}" Content="Create in ETABS" Click="ComboCreate_Click" Background="#0891B2"/>
            </StackPanel>
            <DataGrid x:Name="ComboGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" Height="320">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="90"/>
                <DataGridTextColumn Header="Definition" Binding="{Binding Definition}" Width="*"/>
                <DataGridTextColumn Header="Code reference" Binding="{Binding Reference}" Width="250"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="190"/>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel></ScrollViewer>
        </Border>

        <!-- Floor and wall loads -->
        <Border x:Name="PageFloors" Background="{StaticResource Card}" CornerRadius="6" Padding="20" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="Floor Live Loads (BNBC Table 6.2.3)" FontSize="22" FontWeight="Bold"/>
            <TextBlock Foreground="#9FB4D9" TextWrapping="Wrap" Margin="0,6,0,8"
                       Text="1) Add floors (or read the stories from ETABS). 2) Select one or more floor rows, search the occupancy below and press Set (or double-click it): the minimum uniform live load comes from the table. 3) In ETABS select the slabs of that floor, pick the row here and press Assign. An existing load of that pattern on those slabs is replaced, so nothing is doubled."/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button Style="{StaticResource ActBtn}" Content="Read stories from ETABS" Click="ReadStories_Click"/>
              <Button Style="{StaticResource ActBtn}" Content="Add floor" Click="AddFloor_Click" Background="#334A7A"/>
            </StackPanel>
            <DataGrid x:Name="FloorGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Height="190" SelectionChanged="FloorGrid_SelectionChanged">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Floor / Story" Binding="{Binding Floor}" Width="130"/>
                <DataGridTextColumn Header="Occupancy or use (Table 6.2.3)" Binding="{Binding Occupancy, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="LL kN/m2" Binding="{Binding LL}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" IsReadOnly="True" Width="70"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Find occupancy: type a word (residential, apartment, office, school, roof, stairs...)" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="TxtOccFilter" TextChanged="OccFilter_Changed"/>
            <ListBox x:Name="LstOcc" Height="150" Margin="0,6,0,0" MouseDoubleClick="LstOcc_DoubleClick"/>
            <Button Style="{StaticResource ActBtn}" Content="Set for selected floor(s)" Click="SetOcc_Click" Margin="0,8,0,0" HorizontalAlignment="Left"/>
            <TextBlock x:Name="TxtLiveNote" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <TextBlock Text="ETABS live load pattern:" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox x:Name="TxtLivePat" Text="LIVE" Width="100"/>
              <Button Style="{StaticResource ActBtn}" Content="Assign selected row to selected slabs" Click="AssignLive_Click" Background="#0891B2" Margin="12,0,0,0"/>
            </StackPanel>
            <TextBlock Foreground="#9FB4D9" TextWrapping="Wrap" Margin="0,6,0,0" Text="Not done here: live load reduction (Sec 2.3.13) and concentrated loads. Corridors above the first floor follow the occupancy they serve, so choose that occupancy's own row."/>

            <TextBlock Text="Wall Load Generator" FontSize="22" FontWeight="Bold" Margin="0,26,0,0"/>
            <TextBlock Foreground="#9FB4D9" TextWrapping="Wrap" Margin="0,6,0,0" Text="Line load on a beam: w = (unit weight x thickness + faces x finish) x height x (1 - openings). Unit weights come from Table 6.2.1. Finish and openings are your inputs; nothing is assumed."/>
            <StackPanel MaxWidth="460" HorizontalAlignment="Left">
              <TextBlock Text="Wall material" Style="{StaticResource Lbl}"/><ComboBox x:Name="CmbWallMat" SelectionChanged="Wall_Changed"/>
              <TextBlock Text="Unit weight (kN/m3)" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtGamma" LostFocus="Wall_Changed"/>
              <TextBlock Text="Wall thickness (m), for example 0.125" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtWallT" LostFocus="Wall_Changed"/>
              <TextBlock Text="Wall height (m) = storey height minus beam depth" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtWallH" LostFocus="Wall_Changed"/>
              <TextBlock Text="Finish load per wall face (kN/m2), 0 if none" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtFinish" LostFocus="Wall_Changed"/>
              <TextBlock Text="Faces with finish (0, 1 or 2)" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtFaces" LostFocus="Wall_Changed"/>
              <TextBlock Text="Openings reduction (%), 0 if none" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtOpen" LostFocus="Wall_Changed"/>
              <TextBlock Text="ETABS wall pattern" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtWallPat" Text="WALL"/>
            </StackPanel>
            <TextBlock x:Name="TxtWallResult" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,12,0,0"/>
            <Button Style="{StaticResource ActBtn}" Content="Assign to selected beams" Click="AssignWall_Click" Background="#0891B2" Margin="0,10,0,0" HorizontalAlignment="Left"/>
          </StackPanel></ScrollViewer>
        </Border>

        <!-- Foundation reactions -->
        <Border x:Name="PageReact" Background="{StaticResource Card}" CornerRadius="6" Padding="20" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="Foundation Reaction Extractor" FontSize="22" FontWeight="Bold"/>
            <TextBlock Foreground="#9FB4D9" TextWrapping="Wrap" Margin="0,6,0,8"
                       Text="1) Run the analysis in ETABS. 2) Select the base support joints in ETABS. 3) Type the combination names below (blank = every ULS* and ASD* combination made by this tool) and press Extract. Values are in kN and kN-m. ETABS sign convention: F3 positive means the support pushes upward."/>
            <TextBlock Text="Combinations (comma separated, optional)" Style="{StaticResource Lbl}"/>
            <TextBox x:Name="TxtReactCombos"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
              <Button Style="{StaticResource ActBtn}" Content="Extract from selected joints" Click="Extract_Click" Background="#0891B2"/>
              <Button Style="{StaticResource ActBtn}" Content="Export CSV" Click="ExportReact_Click"/>
            </StackPanel>
            <TextBlock x:Name="TxtReactSummary" FontFamily="Consolas" TextWrapping="Wrap"/>
            <DataGrid x:Name="ReactGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" Height="300" Margin="0,10,0,0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Joint" Binding="{Binding Joint}" Width="70"/>
                <DataGridTextColumn Header="Combo" Binding="{Binding Case}" Width="100"/>
                <DataGridTextColumn Header="Fx" Binding="{Binding F1, StringFormat=0.00}" Width="*"/>
                <DataGridTextColumn Header="Fy" Binding="{Binding F2, StringFormat=0.00}" Width="*"/>
                <DataGridTextColumn Header="Fz (F3)" Binding="{Binding F3, StringFormat=0.00}" Width="*"/>
                <DataGridTextColumn Header="Mx" Binding="{Binding M1, StringFormat=0.00}" Width="*"/>
                <DataGridTextColumn Header="My" Binding="{Binding M2, StringFormat=0.00}" Width="*"/>
                <DataGridTextColumn Header="Mz" Binding="{Binding M3, StringFormat=0.00}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel></ScrollViewer>
        </Border>

        <!-- Seismic static analysis -->
        <Border x:Name="PageSeis" Background="{StaticResource Card}" CornerRadius="6" Padding="20" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="Seismic Static Analysis (BNBC 2020 Sec 2.5.7)" FontSize="22" FontWeight="Bold"/>
            <TextBlock Foreground="#9FB4D9" TextWrapping="Wrap" Margin="0,6,0,8"
                       Text="Z, I and the soil parameters come from Project Setup (location, occupancy, soil from your geotechnical report). Choose the structural system, enter the building height and the story data. Nothing is assumed: missing data gives INCOMPLETE."/>
            <StackPanel MaxWidth="560" HorizontalAlignment="Left">
              <TextBlock Text="Seismic force-resisting system (Table 6.2.19)" Style="{StaticResource Lbl}"/><ComboBox x:Name="CmbSys"/>
              <TextBlock Text="Structure type for the approximate period (Table 6.2.20)" Style="{StaticResource Lbl}"/><ComboBox x:Name="CmbPeriod"/>
              <TextBlock Text="Building height hn from foundation (m)" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtHn"/>
              <TextBlock Text="Period from your ETABS modal analysis (s), optional. Used up to 1.4 x approximate period" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtTan"/>
              <CheckBox x:Name="ChkRegular" Margin="0,10,0,0"><TextBlock TextWrapping="Wrap" Text="I confirm the building has no vertical irregularity (Sec 2.5.5.3.2)"/></CheckBox>
            </StackPanel>
            <TextBlock Text="Story data (heights measured from the base)" Style="{StaticResource Lbl}" Margin="0,14,0,3"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button Style="{StaticResource ActBtn}" Content="Read stories from ETABS" Click="SeisRead_Click"/>
              <Button Style="{StaticResource ActBtn}" Content="Add story" Click="SeisAdd_Click" Background="#334A7A"/>
            </StackPanel>
            <DataGrid x:Name="SeisGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Height="200">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Story" Binding="{Binding Story}" Width="*"/>
                <DataGridTextColumn Header="Height h (m)" Binding="{Binding Height}" Width="100"/>
                <DataGridTextColumn Header="Dead incl. SDL, walls (kN)" Binding="{Binding Dead}" Width="170"/>
                <DataGridTextColumn Header="Live load (kN)" Binding="{Binding Live}" Width="110"/>
                <DataGridTextColumn Header="Live intensity (kN/m2)" Binding="{Binding LiveIntensity}" Width="150"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Foreground="#9FB4D9" TextWrapping="Wrap" Margin="0,6,0,0" Text="Seismic weight of a story = Dead + 25% of Live when live intensity is 3 kN/m2 or less, 50% when above (Sec 2.5.7.3). Add permanent heavy equipment or stored liquid to Dead."/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
              <Button Style="{StaticResource ActBtn}" Content="Calculate" Click="SeisCalc_Click" Background="#0891B2"/>
              <Button Style="{StaticResource ActBtn}" Content="Export Report (.txt)" Click="SeisExport_Click"/>
            </StackPanel>
            <TextBox x:Name="TxtSeisResult" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" AcceptsReturn="True" Height="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            <TextBlock Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,8,0,0" Text="To use this in ETABS, enter the base shear coefficient Sa and exponent k in Define > Load Patterns > Modify Lateral Load > User Coefficient yourself, and set the mass source to Dead + the same live load fractions. Automatic transfer to ETABS is not built yet."/>
          </StackPanel></ScrollViewer>
        </Border>

        <!-- Wind load -->
        <Border x:Name="PageWind" Background="{StaticResource Card}" CornerRadius="6" Padding="20" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="Wind Load (BNBC 2020 Sec 2.4, Method 2)" FontSize="22" FontWeight="Bold"/>
            <TextBlock Foreground="#9FB4D9" TextWrapping="Wrap" Margin="0,6,0,8"
                       Text="Rigid, regular-shaped, enclosed building. The basic wind speed comes from Table 6.2.8 for the location you choose. Exposure, occupancy category and region type are your decisions; nothing is assumed."/>
            <StackPanel MaxWidth="560" HorizontalAlignment="Left">
              <TextBlock Text="Location (Table 6.2.8)" Style="{StaticResource Lbl}"/><ComboBox x:Name="CmbWindLoc" SelectionChanged="WindLoc_Changed"/>
              <TextBlock Text="Basic wind speed V (m/s). Edit only with a documented source" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtWindV"/>
              <TextBlock Text="Occupancy / importance category (Table 6.1.1)" Style="{StaticResource Lbl}"/><ComboBox x:Name="CmbWindCat"/>
              <TextBlock Text="Region type for the importance factor (Table 6.2.9)" Style="{StaticResource Lbl}"/><ComboBox x:Name="CmbWindRegion"/>
              <TextBlock Text="Exposure category (Sec 2.4.6.3)" Style="{StaticResource Lbl}"/><ComboBox x:Name="CmbExposure"/>
              <TextBlock Text="Building plan dimension along X (m)" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtDimX"/>
              <TextBlock Text="Building plan dimension along Y (m)" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtDimY"/>
              <TextBlock Text="Fundamental period T (s), from your ETABS modal analysis. Rigid means T of 1 s or less" Style="{StaticResource Lbl}"/><TextBox x:Name="TxtWindT"/>
              <CheckBox x:Name="ChkWindScope" Margin="0,10,0,0"><TextBlock TextWrapping="Wrap" Text="I confirm Sec 2.4.3.1: regular-shaped building, no across-wind, vortex shedding, galloping, flutter, channeling or buffeting effects"/></CheckBox>
              <CheckBox x:Name="ChkNoTopo" Margin="0,6,0,0"><TextBlock TextWrapping="Wrap" Text="I confirm the hill / ridge / escarpment conditions of Sec 2.4.7.1 are not met, so Kzt = 1.0"/></CheckBox>
            </StackPanel>
            <TextBlock Text="Story levels (elevation z above ground, m)" Style="{StaticResource Lbl}" Margin="0,14,0,3"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button Style="{StaticResource ActBtn}" Content="Read stories from ETABS" Click="WindRead_Click"/>
              <Button Style="{StaticResource ActBtn}" Content="Copy from seismic story data" Click="WindCopy_Click" Background="#334A7A"/>
              <Button Style="{StaticResource ActBtn}" Content="Add story" Click="WindAdd_Click" Background="#334A7A"/>
            </StackPanel>
            <DataGrid x:Name="WindGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Height="170">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Story" Binding="{Binding Story}" Width="*"/>
                <DataGridTextColumn Header="Elevation z (m)" Binding="{Binding Elevation}" Width="160"/>
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
              <Button Style="{StaticResource ActBtn}" Content="Calculate" Click="WindCalc_Click" Background="#0891B2"/>
              <Button Style="{StaticResource ActBtn}" Content="Export forces (.csv)" Click="WindCsv_Click"/>
              <Button Style="{StaticResource ActBtn}" Content="Export report (.txt)" Click="WindTxt_Click"/>
            </StackPanel>
            <TextBox x:Name="TxtWindResult" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" AcceptsReturn="True" Height="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
          </StackPanel></ScrollViewer>
        </Border>

        <!-- Model checker -->
        <Border x:Name="PageCheck" Background="{StaticResource Card}" CornerRadius="6" Padding="20" Visibility="Collapsed">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Model Checker" FontSize="22" FontWeight="Bold"/>
            <TextBlock DockPanel.Dock="Top" Foreground="#9FB4D9" TextWrapping="Wrap" Margin="0,6,0,8"
                       Text="Reads the open ETABS model and your project data. A check that cannot be completed is shown as NOT CHECKED or INCOMPLETE, never as PASS."/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
              <Button Style="{StaticResource ActBtn}" Content="Run checks" Click="RunChecks_Click" Background="#0891B2"/>
              <Button Style="{StaticResource ActBtn}" Content="Export (.csv)" Click="ExportChecks_Click"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" x:Name="TxtCheckSummary" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <DataGrid x:Name="CheckGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Check" Binding="{Binding Check}" Width="230"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                <DataGridTextColumn Header="Detail" Binding="{Binding Details}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>

        <!-- Report -->
        <Border x:Name="PageReport" Background="{StaticResource Card}" CornerRadius="6" Padding="20" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="Calculation Report" FontSize="22" FontWeight="Bold"/>
            <TextBlock Foreground="#9FB4D9" TextWrapping="Wrap" Margin="0,6,0,8"
                       Text="Collects the project data and every result you have produced in this session into one report. Sections you have not calculated are marked as empty, never filled in. For PDF: open the HTML report in your browser and print it to PDF."/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
              <Button Style="{StaticResource ActBtn}" Content="Export Excel (.xlsx)" Click="RptXlsx_Click" Background="#0891B2"/>
              <Button Style="{StaticResource ActBtn}" Content="Export HTML" Click="RptHtml_Click"/>
              <Button Style="{StaticResource ActBtn}" Content="Open in browser (print to PDF)" Click="RptOpen_Click"/>
            </StackPanel>
            <TextBlock Text="What the report will contain" Style="{StaticResource Lbl}"/>
            <TextBlock x:Name="TxtReportInfo" FontFamily="Consolas" TextWrapping="Wrap"/>
          </StackPanel></ScrollViewer>
        </Border>

        <!-- Compliance checker -->
        <Border x:Name="PageComp" Background="{StaticResource Card}" CornerRadius="6" Padding="20" Visibility="Collapsed">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="BNBC 2020 Compliance Checker" FontSize="22" FontWeight="Bold"/>
            <TextBlock DockPanel.Dock="Top" Foreground="#9FB4D9" TextWrapping="Wrap" Margin="0,6,0,8"
                       Text="Collects what this tool has calculated in this session and lists every violation, missing input and limit. Work you have not done is shown as NOT CALCULATED, and missing data is never shown as PASS. This checks the consistency of the tool's own results; it is not an approval of the design."/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
              <Button Style="{StaticResource ActBtn}" Content="Run compliance check" Click="RunCompliance_Click" Background="#0891B2"/>
              <Button Style="{StaticResource ActBtn}" Content="Export (.csv)" Click="ExportCompliance_Click"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" x:Name="TxtCompSummary" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <DataGrid x:Name="CompGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Requirement" Binding="{Binding Check}" Width="250"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                <DataGridTextColumn Header="Detail and code reference" Binding="{Binding Details}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
      </Grid>

      <!-- Messages -->
      <Border Grid.Row="2" Background="#081126" CornerRadius="6" Padding="10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Errors &amp; Warnings / Log" Foreground="{StaticResource Cyan}" FontWeight="SemiBold"/>
          <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" Foreground="White" FontFamily="Consolas"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
